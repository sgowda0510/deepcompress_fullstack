{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: DeepCompress Web App (app.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Python: CLI Pipeline (main.py)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--skip-train", "--dataset", "mnist"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
